# ---------------------------------------------------------------------------
# Template for the .env file.
#
# The .env file holds the CRITICAL configuration of this project and is
# therefore excluded from git via .gitignore. Create it on the machine that
# runs the server:
#
#   cp .env.example .env
#
# EULA has to be set here; everything else is optional and falls back to the
# default values from the Dockerfile.
# ---------------------------------------------------------------------------

# Acceptance of the Minecraft End User Licence Agreement:
# https://www.minecraft.net/eula
#
# Only the person running the server can accept it, so the image does not do
# it for them: the server refuses to start while this is anything but "true".
EULA=false

# Password for RCON (remote console).
# Leave the value empty to keep RCON switched off. RCON is never published to
# the internet by docker-compose.yaml; it is only reachable inside the
# container network.
RCON_PASSWORD=

# ---------------------------------------------------------------------------
# Optional overrides for non-critical values. They have defaults in
# docker-compose.yaml and only need to be set here if you want to change them
# per machine without editing a tracked file.
# ---------------------------------------------------------------------------

# Minecraft version that gets built into the image.
# MINECRAFT_VERSION=26.3

# Java heap size. Lower this on a host that cannot spare 2 GB.
# JAVA_MEMORY=1536M

# Port published on the host. The project is graded on port 8888.
# MC_HOST_PORT=8888
